[sub_resource type="GDScript" id="GDScript_demo"]
script/source = "extends Control

# GodotWebViewSharp 演示场景 - GDScript 辅助
# 对标 godot_wry 的 example.tscn

func _on_web_view_ipc_message(message):
	print(\"Got IPC message: %s\" % message)
	$WebView.PostMessage(\"Hello from Godot C#!\")"

