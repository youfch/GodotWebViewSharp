<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <!-- WebView2 走 COM，NativeAOT 默认不支持内置 COM 互操作，
         缺这个开关会在创建 webview 时报 "COM Interop requires ComWrapper instance registered for marshalling" -->
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>GDEWebView</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <ExcludeFromProductBuild>true</ExcludeFromProductBuild>
  </PropertyGroup>

  <!-- NativeAOT 下 WebView2 是 COM 组件，需要显式打开内置 COM 互操作特性开关 -->
  <ItemGroup>
    <IlcArg Include="--feature:System.Runtime.InteropServices.BuiltInComInterop.IsSupported=true" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Godot.Bindings">
      <HintPath>Dll\Godot.Bindings.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Windows: WebView2 -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3065.39" GeneratePathProperty="true" />
  </ItemGroup>

  <!-- Platform-specific constants -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <DefineConstants>$(DefineConstants);MACOS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <DefineConstants>$(DefineConstants);LINUX</DefineConstants>
  </PropertyGroup>

  <!-- Copy WebView2 runtime files after Build -->
  <Target Name="CopyWebView2Files_Build" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <OutDir>$(TargetDir)</OutDir>
    </PropertyGroup>
    <CallTarget Targets="CopyWebView2Files" />
  </Target>

  <!-- Copy WebView2 runtime files after Publish -->
  <Target Name="CopyWebView2Files_Publish" AfterTargets="Publish" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PropertyGroup>
      <OutDir>$(PublishDir)</OutDir>
    </PropertyGroup>
    <CallTarget Targets="CopyWebView2Files" />
  </Target>

  <Target Name="CopyWebView2Files">
    <Message Text="=== Copying WebView2 runtime to $(OutDir) ===" Importance="high" />
    <ItemGroup>
      <WebView2Files Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-x64\native\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(WebView2Files)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <Message Text="=== WebView2 Copy Complete ===" Importance="high" />
  </Target>

</Project>